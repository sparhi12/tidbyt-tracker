# ==============================================================================
# Tidbyt Flight Tracker Configuration
# Copy this file to .env and configure with your credentials.
# ==============================================================================

# Tidbyt Device Credentials (from Tidbyt mobile app -> Settings -> General)
TIDBYT_DEVICE_ID=your_device_id_here
TIDBYT_API_KEY=your_api_key_here
TIDBYT_INSTALLATION_ID=FlightTracker

# Data Provider Configuration
# Options: 'airplanes_live' (10s live unmetered feed), 'opensky' (registered account), or 'dual' (tries airplanes_live, falls back to opensky)
DATA_SOURCE=dual

# OpenSky Network Account (Optional if using airplanes_live)
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password
# Or OAuth2 credentials if created on OpenSky:
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_POLL_INTERVAL=22

# Geographic Reference Coordinates (Default: Denny Way & Westlake Ave, Seattle)
REF_LAT=47.6186
REF_LON=-122.3365
MAX_RADIUS_MILES=15.0

# Display Refresh Interval (seconds)
POLL_INTERVAL_SECONDS=10

# Prioritize aircraft in the North -> East -> South right hemisphere (0° to 180°)
EASTERN_PRIORITY=true

# Binary and template paths
PIXLET_BIN=pixlet
STAR_PATH=display/flight.star
OUTPUT_IMAGE=/tmp/tidbyt_flight.webp
